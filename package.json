{
  "name": "flix-home-remote",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "hub": "tsx hub/main.ts",
    "typecheck": "tsc --noEmit",
    "build:ssh": "node scripts/build-ssh.mjs",
    "build": "node scripts/sync-web-account.mjs && node scripts/sync-remote-page.mjs && node scripts/stage-ui.mjs && node scripts/build-ssh.mjs && node scripts/build-identity.mjs && tsc --noEmit && vite build && node scripts/stage-day.mjs",
    "stage:day": "node scripts/stage-day.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify:ui-channel": "tsx tests/ios-release-ui-delivery.ts",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.3",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/stream-extra": "^2.6.1",
    "bonjour-service": "^1.3.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "0.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
